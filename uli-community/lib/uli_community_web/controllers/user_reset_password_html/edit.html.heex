<div class="w-full max-w-[453px] mx-auto flex flex-col items-center font-['Labrada']">
  <h1 class="text-center text-[#4e1818] text-[26px] font-light leading-tight mb-2">
    <%= gettext("Reset your password") %>
  </h1>
  <p class="text-center text-[15px] text-[#4e1818]/80 max-w-[340px] mb-8 font-normal">
    <%= gettext("Enter your new password below.") %>
  </p>

  <div class="relative w-full bg-[#ffece6] border border-[#4e1818] p-7 sm:p-9">
    <.form :let={f} for={@changeset} action={~p"/users/reset_password/#{@token}"} class="space-y-4">
      <.error :if={@changeset.action}>
        <%= gettext("Oops, something went wrong! Please check the errors below.") %>
      </.error>

      <div>
        <label for={f[:password].id} class="block text-sm font-normal text-[#4e1818] mb-1.5">
          <%= gettext("New password") %>
        </label>
        <input
          type="password"
          name={f[:password].name}
          id={f[:password].id}
          value={Phoenix.HTML.Form.normalize_value("password", f[:password].value)}
          required
          autofocus
          placeholder="••••••••"
          class="w-full px-3.5 py-2.5 bg-white border border-[#4e1818] text-[#4e1818] placeholder-[#4e1818]/40 text-sm font-['Labrada'] focus:outline-none focus:border-[#ff5e00] focus:ring-1 focus:ring-[#ff5e00] transition-colors duration-150"
        />
        <.error :for={msg <- f[:password].errors}><%= msg %></.error>
      </div>

      <div>
        <label for={f[:password_confirmation].id} class="block text-sm font-normal text-[#4e1818] mb-1.5">
          <%= gettext("Confirm new password") %>
        </label>
        <input
          type="password"
          name={f[:password_confirmation].name}
          id={f[:password_confirmation].id}
          value={Phoenix.HTML.Form.normalize_value("password", f[:password_confirmation].value)}
          required
          placeholder="••••••••"
          class="w-full px-3.5 py-2.5 bg-white border border-[#4e1818] text-[#4e1818] placeholder-[#4e1818]/40 text-sm font-['Labrada'] focus:outline-none focus:border-[#ff5e00] focus:ring-1 focus:ring-[#ff5e00] transition-colors duration-150"
        />
        <.error :for={msg <- f[:password_confirmation].errors}><%= msg %></.error>
      </div>

      <div class="pt-3">
        <button
          type="submit"
          phx-disable-with={gettext("Resetting...")}
          class="w-full h-[42px] bg-[#4e1818] border border-[#4e1818] text-[#fdf6ed] font-['Labrada'] text-[15px] font-normal inline-flex items-center justify-center transition-colors duration-150 hover:bg-[#ff5e00] hover:border-[#ff5e00] hover:text-white cursor-pointer"
        >
          <%= gettext("Reset Password") %> <span aria-hidden="true" class="ml-2 font-mono">→</span>
        </button>
      </div>
    </.form>
  </div>

  <div class="mt-6 flex items-center justify-center gap-3 text-sm text-[#4e1818]">
    <.link href={~p"/users/register"} class="font-normal text-[#4e1818] underline hover:text-[#ff5e00] transition-colors duration-150">
      <%= gettext("Register") %>
    </.link>
    <span>•</span>
    <.link href={~p"/users/log_in"} class="font-normal text-[#4e1818] underline hover:text-[#ff5e00] transition-colors duration-150">
      <%= gettext("Log in") %>
    </.link>
  </div>
</div>
