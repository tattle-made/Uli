<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      <%= assigns[:page_title] || "Uli Community" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="">
    <ul class="relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
    <li class="mr-auto">
    <a href="/" class="m-1">
        <img src={~p"/images/Uli_Logo.png"} width="56" />
      </a>
    </li>
      <%= if @current_user do %>
        <li class="text-[0.8125rem] leading-6 text-zinc-900">
          <%= @current_user.email %>
        </li>
        <li>
          <.link
            href={~p"/users/settings"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            <%= gettext("Settings") %>
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            <%= gettext("Log out") %>
          </.link>
        </li>
      <% else %>
        <li>
          <.link
            href={~p"/users/register"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            <%= gettext("Register") %>
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_in"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            <%= gettext("Log in") %>
          </.link>
        </li>
      <% end %>
      <li class="relative group">
        <button
          class="flex items-center text-zinc-600 hover:text-zinc-900 transition-colors"
          aria-label="Select language"
        >
          <.icon name="hero-language" class="w-5 h-5" />
        </button>
        <div class="absolute right-0 top-full pt-1 hidden group-hover:block z-50">
          <ul class="min-w-[10rem] rounded-lg border border-zinc-200 bg-white py-1 shadow-lg text-sm text-zinc-700">
            <li>
              <a
                href={~p"/locale/en"}
                class={"block px-4 py-2 hover:bg-zinc-50 #{if assigns[:locale] == "en", do: "font-semibold text-zinc-900", else: ""}"}
              >
                English
              </a>
            </li>
            <li>
              <a
                href={~p"/locale/hi"}
                class={"block px-4 py-2 hover:bg-zinc-50 #{if assigns[:locale] == "hi", do: "font-semibold text-zinc-900", else: ""}"}
              >
                हिंदी
              </a>
            </li>
          </ul>
        </div>
      </li>
    </ul>
    <%= @inner_content %>
  </body>
</html>
