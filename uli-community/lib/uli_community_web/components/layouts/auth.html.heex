<div class="relative w-full min-h-screen bg-[#fdf6ed] flex flex-col items-center text-neutral-900 font-['Labrada'] antialiased">
  
  <!-- Top Horizontal Cross-stitch Border -->
  <div 
    class="w-full h-[27px] bg-cross-stitch-h z-40 shrink-0" 
    style="transform: rotate(180deg);"
  ></div>

  <!-- Left Vertical Cross-stitch Border -->
  <div 
    class="absolute top-[27px] bottom-[27px] left-0 w-[32px] bg-cross-stitch-v pointer-events-none z-40 hidden sm:block"
  ></div>

  <!-- Right Vertical Cross-stitch Border -->
  <div 
    class="absolute top-[27px] bottom-[27px] right-0 w-[32px] bg-cross-stitch-v pointer-events-none z-40 hidden sm:block" 
    style="transform: scaleX(-1);"
  ></div>

  <!-- Language Switcher in top corner (Homepage hover effects) -->
  <div class="absolute top-9 right-6 sm:right-12 z-50">
    <div class="relative group">
      <button
        class="flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#e2d8cc] rounded-lg text-[#4e1818] hover:bg-[#ff5e00] hover:border-[#ff5e00] hover:text-white shadow-sm transition-colors duration-150 text-xs font-['Labrada'] cursor-pointer"
        aria-label="Select language"
      >
        <.icon name="hero-language" class="w-4 h-4" />
        <span class="uppercase font-semibold"><%= assigns[:locale] || "en" %></span>
        <.icon name="hero-chevron-down" class="w-3 h-3" />
      </button>
      <div class="absolute right-0 top-full pt-1.5 hidden group-hover:block z-50">
        <ul class="min-w-[8rem] border border-[#e2d8cc] bg-white rounded-lg shadow-md py-1 text-xs text-[#4e1818] font-['Labrada'] overflow-hidden">
          <li>
            <a
              href={~p"/locale/en"}
              class={"block px-3 py-2 hover:bg-[#ff5e00] hover:text-white transition-colors duration-150 #{if assigns[:locale] == "en", do: "font-semibold bg-[#ffece6] text-[#4e1818]", else: ""}"}
            >
              English
            </a>
          </li>
          <li>
            <a
              href={~p"/locale/hi"}
              class={"block px-3 py-2 hover:bg-[#ff5e00] hover:text-white transition-colors duration-150 #{if assigns[:locale] == "hi", do: "font-semibold bg-[#ffece6] text-[#4e1818]", else: ""}"}
            >
              हिंदी
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Central Single Column Container -->
  <div class="w-full max-w-[480px] mx-auto px-4 sm:px-6 pt-10 pb-16 flex flex-col items-center flex-1 relative z-20">
    
    <!-- Top Pinned Brand Header (2x spacing below logo) -->
    <header class="flex items-center justify-center mb-16">
      <.link href="/" class="transition-opacity hover:opacity-80">
        <img 
          src={~p"/images/figma_landing/uli_community_header_logo.svg"} 
          alt="Uli Community" 
          class="h-[32px] w-auto object-contain select-none" 
        />
      </.link>
    </header>

    <main class="w-full flex flex-col items-center font-['Labrada']">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </main>
  </div>

  <!-- Bottom Horizontal Cross-stitch Border -->
  <div 
    class="w-full h-[27px] bg-cross-stitch-h z-40 shrink-0 mt-auto"
  ></div>

</div>
