<div class="min-h-screen px-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col items-start gap-6 lg:flex-row lg:gap-[10px]">
    <!-- Left Sidebar: My Contributions -->
    <div class="w-full lg:w-[390px] lg:shrink-0">
      <div class="bg-[#efe2d2] border border-black/20 rounded-[10px] px-5 pt-5 pb-10">
        <div class="flex items-center justify-between gap-3 mb-4">
          <div class="min-w-0">
            <h2 class="text-lg font-semibold">My Contributions</h2>
            <span class="block text-sm font-medium">{@current_user.email}</span>
          </div>
          <.link
            href={~p"/contribute-slur"}
            class="inline-flex h-12 w-[101px] shrink-0 items-center justify-center gap-[10px] rounded-[5px] border border-black/10 bg-black px-[10px] text-xs font-bold text-[#fdf6ed] hover:bg-gray-800"
          >
            <span aria-hidden="true" class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#fcf5ec]">
              <svg class="h-3 w-3 text-black" fill="none" viewBox="0 0 12 12">
                <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M6 1v10M1 6h10" />
              </svg>
            </span>
            <span class="whitespace-nowrap">Add Slur</span>
          </.link>
        </div>
        <div class="border-t border-[#d7cbbd] mb-4"></div>

        <div class="mb-4">
          <input
            type="text"
            placeholder="Search"
            class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
          />
        </div>

<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
  <div class="inline-flex h-[30px] shrink-0 items-center whitespace-nowrap rounded-full border border-[#d7cbbd] px-5 text-xs font-bold text-[#787169]">
            {length(@my_contributions)} Contributions
          </div>
          <label class="inline-flex h-[34px] items-center gap-[6px] rounded-full border border-black/50 px-[10px] text-xs">
            <svg aria-hidden="true" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3v3m8-3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Zm7 7v5m-2-2 2 2 2-2" />
            </svg>
            <span class="shrink-0 font-bold">Sort:</span>
            <select class="appearance-none border-0 bg-transparent p-0 text-xs focus:ring-0">
              <option class="bg-[#efe2d2] text-black">Newest First</option>
              <option class="bg-[#efe2d2] text-black">Oldest First</option>
            </select>
            <svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" />
            </svg>
          </label>
        </div>
        <div class="border-t border-[#d7cbbd] mb-4"></div>

        <div class="space-y-2 max-h-96 overflow-y-auto pr-1">
          <p :if={@my_contributions == []} class="text-sm text-gray-500">
            You haven't added any slurs yet.
          </p>
          <.link
            :for={contribution <- @my_contributions}
            href={~p"/contribute-slur/#{contribution.id}"}
            class={[
              "block rounded-[10px] px-5 py-3 text-[17px] font-bold",
              if(@slur && contribution.id == @slur.id,
                do: "bg-white border-2 border-[#fa9391]",
                else: "bg-[#fdf6ed] border border-black/10 opacity-60"
              )
            ]}
          >
            <div class="text-sm">{contribution.label}</div>
          </.link>
        </div>
      </div>
    </div>

    <!-- Right Content: Form -->
    <div class="flex-1">
      <div class="w-full max-w-[800px] rounded-[10px] border border-black/20 bg-white/20 p-6 sm:px-10 sm:pt-5 sm:pb-10">
        <div class="flex items-center justify-between border-b border-[#b7b4b5] pb-5 mb-6">
          <h1 class="text-lg font-bold">
            {if(@mode == :edit, do: "Edit Slur", else: "Add Slur")}
          </h1>
          <button
            :if={@mode == :edit}
            class="inline-flex h-12 items-center justify-center gap-2 rounded-[5px] border border-[#bf0000] px-6 font-semibold text-[#bf0000] hover:bg-[#bf0000]/5"
            phx-click="delete"
            data-confirm="Are you sure?"
          >
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 -960 960 960" fill="currentColor">
              <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
            </svg>
            <span>Delete</span>
          </button>
        </div>

        <.form id="slur-submission-form" :let={f} for={@form} phx-submit="save" class="space-y-6">
          <!-- What is the slur? -->
          <div>
          <label class="block text-lg font-bold mb-1">
            What is the slur?
          </label>
          <p class="text-lg text-gray-600 mb-3">
              How is this slur commonly spelled.
            </p>
            <.input
              field={f[:label]}
              type="text"
              placeholder="Enter slur label"
              readonly={@mode == :edit}
              class={"w-full px-3 py-3 font-semibold text-lg! leading-7! border border-gray-300 rounded-[10px] focus:ring-2 focus:ring-orange-400 focus:border-transparent" <> if(@mode == :edit, do: " bg-gray-100 cursor-not-allowed", else: "")}
            />
            <%!-- <div class="mt-3 p-3 bg-orange-50 rounded flex items-center gap-2">
              <span class="text-2xl">🔍</span>
              <span class="text-sm text-gray-700">
                Search Result: Is it similar to (select any):
              </span>
            </div> --%>
          </div>

          <!-- Level of Severity -->
          <div>
            <label class="block text-lg font-bold mb-2">
              Level of Severity
            </label>
            <div class="flex flex-wrap gap-2">
              <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-black/60 bg-[#f2e6d9] px-3 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:level_of_severity].name} value="low" checked={to_string(f[:level_of_severity].value) == "low"} />
                <span class="h-3 w-3 rounded-full border border-black/40 bg-yellow-300"></span>
                <span class="text-sm font-medium lowercase">Low</span>
              </label>
              <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-black/60 bg-[#f2e6d9] px-3 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:level_of_severity].name} value="medium" checked={to_string(f[:level_of_severity].value) == "medium"} />
                <span class="h-3 w-3 rounded-full border border-black/40 bg-amber-500"></span>
                <span class="text-sm font-medium lowercase">Medium</span>
              </label>
              <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-black/60 bg-[#f2e6d9] px-3 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:level_of_severity].name} value="high" checked={to_string(f[:level_of_severity].value) == "high"} />
                <span class="h-3 w-3 rounded-full border border-black/40 bg-red-500"></span>
                <span class="text-sm font-medium lowercase">High</span>
              </label>
            </div>
            <.error :for={msg <- field_errors(f[:level_of_severity])}>{msg}</.error>
          </div>

          <!-- Is it Casual? -->
          <div>
            <label class="block text-lg font-bold mb-2">
              Is it Casual?
            </label>
            <div class="flex flex-wrap gap-2">
              <label class="inline-flex cursor-pointer items-center rounded-xl border border-black/60 bg-[#f2e6d9] px-4 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:casual].name} value="true" checked={to_string(f[:casual].value) == "true"} />
                <span class="text-sm font-medium">Yes</span>
              </label>
              <label class="inline-flex cursor-pointer items-center rounded-xl border border-black/60 bg-[#f2e6d9] px-4 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:casual].name} value="false" checked={to_string(f[:casual].value) == "false"} />
                <span class="text-sm font-medium">No</span>
              </label>
            </div>
            <.error :for={msg <- field_errors(f[:casual])}>{msg}</.error>
          </div>

          <!-- Has it been appropriated? -->
          <div>
            <label class="block text-lg font-bold mb-2">
              Has it been appropriated?
            </label>
            <div class="flex flex-wrap gap-2">
              <label class="inline-flex cursor-pointer items-center rounded-xl border border-black/60 bg-[#f2e6d9] px-4 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:appropriated].name} value="true" checked={to_string(f[:appropriated].value) == "true"} />
                <span class="text-sm font-medium">Yes</span>
              </label>
              <label class="inline-flex cursor-pointer items-center rounded-xl border border-black/60 bg-[#f2e6d9] px-4 py-2 opacity-60 has-[:checked]:border-2 has-[:checked]:border-black has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:appropriated].name} value="false" checked={to_string(f[:appropriated].value) == "false"} />
                <span class="text-sm font-medium">No</span>
              </label>
            </div>
            <.error :for={msg <- field_errors(f[:appropriated])}>{msg}</.error>
          </div>

          <!-- Who has it been Appropriated by -->
          <div class="flex w-full flex-col items-start gap-[10px] rounded-[5px] border border-black/10 bg-[#efe2d2] p-[10px]">
            <div class="flex items-center gap-[5px] text-[17px] font-bold text-black/50">
              <span aria-hidden="true" class="inline-flex h-6 w-6 items-center justify-center rounded-full border-2 border-[#787169] text-[17px] leading-none text-[#787169]">?</span>
              <span>Who has it been Appropriated by</span>
            </div>
            <div class="w-full border-t border-black/10"></div>
            <div class="flex flex-wrap gap-[10px]">
              <label class="inline-flex cursor-pointer items-center rounded-[10px] border border-black bg-[#efe2d2] px-[15px] py-[5px] opacity-50 has-[:checked]:border-2 has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:appropriation_context].name} value="true" checked={to_string(f[:appropriation_context].value) == "true"} />
                <span class="text-[13px] font-normal">By the Community</span>
              </label>
              <label class="inline-flex cursor-pointer items-center rounded-[10px] border border-black bg-[#efe2d2] px-[15px] py-[5px] opacity-50 has-[:checked]:border-2 has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                <input type="radio" class="sr-only" name={f[:appropriation_context].name} value="false" checked={to_string(f[:appropriation_context].value) == "false"} />
                <span class="text-[13px] font-normal">Others / People outside the community</span>
              </label>
            </div>
          </div>

          <!-- What makes it problematic? -->
          <div>
            <label class="block text-lg font-bold mb-2">
              What makes it problematic?
            </label>
            <.input
              field={f[:meaning]}
              type="textarea"
              class="w-full min-h-[115px] resize-y rounded-[4px] border border-gray-300 px-[10px] py-[10px] text-[18px] focus:ring-2 focus:ring-orange-400 focus:border-transparent"
            />
          </div>

          <!-- Categories -->
          <div>
            <label class="block text-lg font-bold mb-2">
              Categories?
            </label>
            <div class="flex gap-2 flex-wrap">
              <% selected_categories = f[:categories].value |> List.wrap() |> Enum.map(&to_string/1) %>
              <%= for {value, label} <- [
                {"gendered", "Gender"},
                {"sexualized", "Sexualized"},
                {"religion", "Religion"},
                {"ethnicity", "Ethnicity"},
                {"political_affiliation", "Political Affiliation"},
                {"caste", "Caste"},
                {"class", "Class"},
                {"body_shaming", "Body Shaming"},
                {"ableist", "Ableist"},
                {"sexual_identity", "Sexual Identity"},
                {"other", "Other"}
              ] do %>
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-black bg-black/20 px-3 py-2 text-sm opacity-50 has-[:checked]:bg-[#ffcbca] has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                  <input type="checkbox" class="peer sr-only" name={f[:categories].name <> "[]"} value={value} checked={value in selected_categories} />
                  <span aria-hidden="true" class="hidden h-3 w-3 items-center justify-center rounded-full bg-[#bf0000] text-white peer-checked:inline-flex">
                    <svg class="h-2 w-2" viewBox="0 0 10 10" fill="none">
                      <path d="M1.5 5.5 3.8 7.8 8.5 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="font-normal">{label}</span>
                </label>
              <% end %>
            </div>
            <.error :for={msg <- field_errors(f[:categories])}>{msg}</.error>
          </div>

          <!-- Language -->
          <div>
            <label class="block text-lg font-bold mb-2">
              Language
            </label>
            <div class="flex gap-2 flex-wrap">
              <%= for {name, code} <- @language_options do %>
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-black bg-black/20 px-3 py-2 text-sm opacity-50 has-[:checked]:border-2 has-[:checked]:bg-white has-[:checked]:opacity-100 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-black">
                  <input type="radio" class="peer sr-only" name={f[:language].name} value={code} checked={to_string(f[:language].value) == code} />
                  <span aria-hidden="true" class="hidden h-3 w-3 items-center justify-center rounded-full bg-[#bf0000] text-white peer-checked:inline-flex">
                    <svg class="h-2 w-2" viewBox="0 0 10 10" fill="none">
                      <path d="M1.5 5.5 3.8 7.8 8.5 2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="font-normal">{name} / <code class="font-sans text-inherit">&lt;{String.upcase(code)}&gt;</code></span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-8">
            <button
              type="submit"
              class="flex h-[88px] w-full items-center justify-center gap-2 rounded-[10px] bg-black px-6 text-lg font-semibold text-white hover:bg-gray-800"
            >
              <svg aria-hidden="true" class="h-6 w-6 shrink-0" viewBox="0 -960 960 960" fill="currentColor">
                <path d="M840-680v480q0 33-23.5 56.5T760-120H200q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h480l160 160Zm-80 34L646-760H200v560h560v-446ZM480-240q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35ZM240-560h360v-160H240v160Zm-40-86v446-560 114Z"/>
              </svg>
              <span>Save &amp; Submit Slur</span>
            </button>
          </div>
        </.form>
      </div>
    </div>
  </div>
</div>
