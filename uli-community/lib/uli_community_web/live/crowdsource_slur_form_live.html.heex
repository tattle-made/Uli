<div class="flex gap-6 p-6 bg-gray-50 min-h-screen">
  <!-- Left Sidebar: My Contributions -->
  <div class="w-80">
    <div class="bg-white rounded-lg p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold">My Contributions</h2>
        <span class="text-sm font-medium"><%= @current_user.email %></span>
      </div>

      <.link href={~p"/contribute-slur"} class="w-full mb-4 bg-black text-white px-4 py-2 rounded font-medium hover:bg-gray-800 flex items-center justify-center gap-2">
        ➕ Add Slur
      </.link>

      <div class="mb-4">
        <input
          type="text"
          placeholder="Search"
          class="w-full px-3 py-2 border border-gray-300 rounded text-sm"
        />
      </div>

      <div class="text-sm text-gray-600 mb-4">
        <strong><%= length(@my_contributions) %> Contributions</strong>
      </div>

      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <select class="text-sm border border-gray-300 rounded px-2 py-1">
          <option>Sort: Newest First</option>
          <option>Oldest First</option>
        </select>
      </div>

      <div class="space-y-2 max-h-96 overflow-y-auto pr-1">
        <p :if={@my_contributions == []} class="text-sm text-gray-500">
          You haven't added any slurs yet.
        </p>
        <.link
          :for={contribution <- @my_contributions}
          href={~p"/contribute-slur/#{contribution.id}"}
          class={[
            "block p-3 rounded",
            if(@slur && contribution.id == @slur.id,
              do: "bg-red-50 border-l-4 border-red-400 hover:bg-red-100",
              else: "bg-gray-100 hover:bg-gray-200"
            )
          ]}
        >
          <div class="font-medium text-sm"><%= contribution.label %></div>
        </.link>
      </div>
    </div>
  </div>

  <!-- Right Content: Form -->
  <div class="flex-1">
    <div class="bg-white rounded-lg p-8 shadow-sm max-w-2xl">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold">
          <%= if @mode == :edit, do: "Edit Slur", else: "Add Slur" %>
        </h1>
        <%= if @mode == :edit do %>
          <button
            class="px-4 py-2 text-red-600 border border-red-600 rounded hover:bg-red-50"
            phx-click="delete"
            data-confirm="Are you sure?"
          >
            🗑️ Delete
          </button>
        <% end %>
      </div>

      <.form :let={f} for={@form} phx-submit="save" class="space-y-6">
        <!-- What is the slur? -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            What is the slur?
          </label>
          <p class="text-sm text-gray-600 mb-3">
            How is this slur commonly spelled.
          </p>
          <.input
            field={f[:label]}
            type="text"
            placeholder="Enter slur label"
            readonly={@mode == :edit}
            class={"w-full px-4 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-orange-400 focus:border-transparent" <> if(@mode == :edit, do: " bg-gray-100 cursor-not-allowed", else: "")}
          />
          <%!-- <div class="mt-3 p-3 bg-orange-50 rounded flex items-center gap-2">
            <span class="text-2xl">🔍</span>
            <span class="text-sm text-gray-700">
              Search Result: Is it similar to (select any):
            </span>
          </div> --%>
        </div>

        <!-- Level of Severity -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            Level of Severity
          </label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:level_of_severity].name} value="low" checked={to_string(f[:level_of_severity].value) == "low"} />
              <span class="text-sm">🟡 Low</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:level_of_severity].name} value="medium" checked={to_string(f[:level_of_severity].value) == "medium"} />
              <span class="text-sm">🟠 Medium</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:level_of_severity].name} value="high" checked={to_string(f[:level_of_severity].value) == "high"} />
              <span class="text-sm">🔴 High</span>
            </label>
          </div>
          <.error :for={msg <- field_errors(f[:level_of_severity])}><%= msg %></.error>
        </div>

        <!-- Is it Casual? -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            Is it Casual?
          </label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:casual].name} value="true" checked={to_string(f[:casual].value) == "true"} />
              <span class="text-sm">Yes</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:casual].name} value="false" checked={to_string(f[:casual].value) == "false"} />
              <span class="text-sm">No</span>
            </label>
          </div>
          <.error :for={msg <- field_errors(f[:casual])}><%= msg %></.error>
        </div>

        <!-- Has it been appropriated? -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            Has it been appropriated?
          </label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:appropriated].name} value="true" checked={to_string(f[:appropriated].value) == "true"} />
              <span class="text-sm">Yes</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name={f[:appropriated].name} value="false" checked={to_string(f[:appropriated].value) == "false"} />
              <span class="text-sm">No</span>
            </label>
          </div>
          <.error :for={msg <- field_errors(f[:appropriated])}><%= msg %></.error>
        </div>

        <!-- Who has it been Appropriated by -->
        <div>
          <label class="block text-sm font-semibold mb-2 flex items-center gap-2">
            <span>💬 Who has it been Appropriated by</span>
          </label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 px-4 py-2 border-2 border-orange-400 rounded cursor-pointer">
              <input type="radio" name={f[:appropriation_context].name} value="true" checked={to_string(f[:appropriation_context].value) == "true"} />
              <span class="text-sm">By the Community</span>
            </label>
            <label class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded cursor-pointer">
              <input type="radio" name={f[:appropriation_context].name} value="false" checked={to_string(f[:appropriation_context].value) == "false"} />
              <span class="text-sm">Others / People outside the community</span>
            </label>
          </div>
        </div>

        <!-- What makes it problematic? -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            What makes it problematic?
          </label>
          <.input
            field={f[:meaning]}
            type="textarea"
            class="w-full px-4 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-orange-400 focus:border-transparent"
          />
        </div>

        <!-- Categories -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            Categories?
          </label>
          <div class="flex gap-2 flex-wrap">
            <% selected_categories = f[:categories].value |> List.wrap() |> Enum.map(&to_string/1) %>
            <%= for {value, label} <- [
              {"gendered", "Gender"},
              {"sexualized", "Sexualized"},
              {"religion", "Religion"},
              {"ethnicity", "Ethnicity"},
              {"political_affiliation", "Political Affiliation"},
              {"caste", "Caste"},
              {"class", "Class"},
              {"body_shaming", "Body Shaming"},
              {"ableist", "Ableist"},
              {"sexual_identity", "Sexual Identity"},
              {"other", "Other"}
            ] do %>
              <label class={[
                "flex items-center gap-2 px-3 py-1 rounded-full cursor-pointer",
                if(value in selected_categories, do: "border-2 border-orange-400", else: "border border-gray-300")
              ]}>
                <input type="checkbox" name={f[:categories].name <> "[]"} value={value} checked={value in selected_categories} />
                <span class="text-sm"><%= label %></span>
              </label>
            <% end %>
          </div>
          <.error :for={msg <- field_errors(f[:categories])}><%= msg %></.error>
        </div>

        <!-- Language -->
        <div>
          <label class="block text-sm font-semibold mb-2">
            Language
          </label>
          <div class="flex gap-2 flex-wrap">
            <%= for {name, code} <- @language_options do %>
              <label class="flex items-center gap-2 px-3 py-1 border border-gray-300 rounded-full cursor-pointer hover:border-orange-400">
                <input type="radio" name={f[:language].name} value={code} checked={to_string(f[:language].value) == code} />
                <span class="text-sm"><%= name %> / <code class="text-xs"><%= String.upcase(code) %></code></span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4 border-t">
          <button
            type="submit"
            class="w-full bg-black text-white px-6 py-3 rounded font-semibold hover:bg-gray-800 flex items-center justify-center gap-2"
          >
            💾 Save & Submit Slur
          </button>
        </div>
      </.form>
    </div>
  </div>
</div>
