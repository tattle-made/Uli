<.modal id="add-slur-modal" on_cancel={JS.push("close-modal")}>
  <.header class="text-center">{gettext("Approve Slur and Slur Metadata")}</.header>
  <.simple_form
    for={@slur_form}
    phx-submit={
      JS.push((@approve_type == "only-slur" && "add-only-slur") || "add-slur-metadata")
      |> hide_modal("add-slur-modal")
    }
  >
    <.header class="text-center">
      <.input
        required
        phx-change="update-form-type"
        class="text-center"
        type="select"
        options={[
          {gettext("Approve Slur Only"), "only-slur"},
          {gettext("Approve Slur Metadata"), "slur-metadata"}
        ]}
        field={@slur_form[:approve_type]}
      />
    </.header>
    <%= if @approve_type == "slur-metadata" do %>
      <p class="text-xs m-0 p-0 text-slate-700">
        {gettext("Frequency of Metadata with same label")}:
        <%= if @already_present_metadata_freq > 0 do %>
          <a href={"/plugin-metadata/#{@selected_slur["label"]}"} class="font-semibold underline">
            {@already_present_metadata_freq}
          </a>
        <% else %>
          <span class="font-semibold">
            {@already_present_metadata_freq}
          </span>
        <% end %>
      </p>
    <% end %>

    <div class="flex gap-4">
      <div class="flex-1">
        <.input required label={gettext("Slur Label")} field={@slur_form[:label]} />
      </div>
      <.input
        required
        label={gettext("Language")}
        type="select"
        options={@language_options}
        field={@slur_form[:language]}
      />
    </div>

    <%= if @approve_type == "slur-metadata" do %>
      <div class="flex justify-between">
        <.input
          required
          label={gettext("Level of Severity")}
          type="select"
          options={[
            {gettext("Low"), "low"},
            {gettext("Medium"), "medium"},
            {gettext("High"), "high"}
          ]}
          field={@slur_form[:level_of_severity]}
        />
        <.input
          required
          label={gettext("Is Casual?")}
          type="select"
          options={[
            {gettext("Yes"), true},
            {gettext("No"), false}
          ]}
          field={@slur_form[:casual]}
        />

        <%!-- </div>
      <div class="flex justify-start gap-12"> --%>
        <.input
          required
          label={gettext("Is Appropriated?")}
          type="select"
          options={[
            {gettext("Yes"), true},
            {gettext("No"), false}
          ]}
          field={@slur_form[:appropriated]}
        />
        <.input
          label={gettext("Appropriation Context")}
          type="select"
          options={[
            {gettext("Null"), nil},
            {gettext("Community"), true},
            {gettext("Others"), false}
          ]}
          field={@slur_form[:appropriation_context]}
        />
      </div>
      <.input required label={gettext("Meaning")} type="textarea" field={@slur_form[:meaning]} />
      <.input
        required
        label={gettext("Categories")}
        type="select"
        multiple
        options={[
          {gettext("Gendered"), :gendered},
          {gettext("Sexualized"), :sexualized},
          {gettext("Religion"), :religion},
          {gettext("Ethnicity"), :ethnicity},
          {gettext("Political Affiliation"), :political_affiliation},
          {gettext("Caste"), :caste},
          {gettext("Class"), :class},
          {gettext("Body Shaming"), :body_shaming},
          {gettext("Ableist"), :ableist},
          {gettext("Sexual Identity"), :sexual_identity},
          {gettext("Other"), :other}
        ]}
        field={@slur_form[:categories]}
      />
    <% end %>

    <div class="flex gap-4 justify-center">
      <.button
        phx-click={hide_modal("add-slur-modal")}
        type="button"
        class="bg-red-400 hover:bg-red-500"
      >
        {gettext("Cancel")}
      </.button>

      <%= if @approve_type == "only-slur" do %>
        <.button type="submit" disabled={@slur_already_added?}>
          <%= if @slur_already_added? do %>
            {gettext("Slur Already Added")}
          <% else %>
            {gettext("Add Only Slur")}
          <% end %>
        </.button>
      <% else %>
        <.button type="submit">{gettext("Save Slur Metadata")}</.button>
      <% end %>
    </div>
  </.simple_form>
</.modal>

<.header class="text-center text-4xl">
  {gettext("Crowdsource Contributions")}
</.header>

<div class="flex justify-center mt-6 mb-6">
  <div class="flex items-center gap-2">
    <form phx-submit="search" class="relative w-64 flex">
      <input
        type="text"
        name="search"
        placeholder={gettext("Search slurs...")}
        value={Keyword.get(@search_params, :search, "")}
        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-500 focus:border-transparent"
      />

      <button
        type="submit"
        class="absolute right-2 top-1/2 -translate-y-1/2 h-8 w-8 flex items-center justify-center border border-zinc-400 rounded-md bg-white"
      >
        <.icon name="hero-magnifying-glass" class="h-4 w-4 text-gray-500" />
      </button>
    </form>

    <.link
      href={~p"/contribute-slur"}
      class="px-4 py-2 bg-black text-white rounded-lg flex items-center gap-2"
    >
      ➕ Add New Slur
    </.link>
  </div>
</div>

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-4">
  <!-- Left Side -->
  <div class="text-slate-900">
    <!-- Responsive heading -->
    <h1 class="text-base sm:text-lg md:text-xl font-normal truncate">
      {gettext("Showing all %{count} contributions", count: @query_count)}
    </h1>
    <!-- Clear Filters (only tablet/laptop and larger) -->
    <.link
      href={
        ~p"/crowdsource-contributions?page_num=1&sort=newest&level_of_severity=all&language=all&casual=all&appropriated=all&source=all"
      }
      class="hidden md:inline-flex mt-4 items-center gap-1 text-sm text-zinc-500 hover:text-zinc-700 transition-colors"
    >
      <.icon name="hero-x-circle" class="w-4 h-4" />
      <span>{gettext("Clear All Filters")}</span>
    </.link>
    <!-- Advanced Search -->
    <form phx-change="toggle-advanced-search" class="flex items-center mt-4 text-sm text-zinc-600">
      <input
        type="checkbox"
        name="advanced_search"
        id="advanced_search"
        checked={@advanced_search}
        class="h-4 w-4 rounded border-gray-300 text-zinc-600 focus:ring-zinc-500"
      />
      <label for="advanced_search" class="ml-2 text-zinc-800 font-medium text-base">
        {gettext("Enable Advanced Search")}
      </label>
    </form>
  </div>
</div>

<div class="flex flex-col sm:flex-row">
  <div class="hidden lg:flex h-fit w-full lg:w-1/5 lg:h-fit flex-col mr-4 border-e border-zinc-200">
    <%= unless @advanced_search do %>
      <div>
        <p class="py-2">{gettext("Date")}</p>
        <div id="date-range-selector" phx-hook="DateSelector" class="flex-row gap-2 flex-wrap">
          <div class="flex flex-row gap-2 text-xs items-center">
            <label for="from">{gettext("from")}&nbsp;&nbsp;</label>
            <input
              class="text-xs text-black dark:text-black dark:bg-dark-bg mt-1 mr-1 block w-fit rounded border-gray-200 focus:border-gray-400 dark:border-gray-600"
              type="date"
              id="from"
              name="from"
              value={Keyword.get(@search_params, :from)}
              phx-change="change-search"
              phx-value-name="date-range"
              phx-value-type="start"
            />
          </div>
          <div class="flex flex-row gap-2 text-xs items-center">
            <label for="to">{gettext("to")}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </label>
            <input
              class="text-xs text-black dark:text-black dark:bg-dark-bg mt-1 mr-1 block w-fit rounded border-gray-200 focus:border-gray-400 dark:border-gray-600"
              type="date"
              id="to"
              name="to"
              value={Keyword.get(@search_params, :to)}
              phx-change="change-search"
              phx-value-name="date-range"
              phx-value-type="end"
            />
          </div>
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Level of Severity")}</p>
        <div>
          <.input_radio
            name="level_of_severity"
            id="low"
            value="low"
            label={gettext("Low")}
            selection={Keyword.get(@search_params, :level_of_severity)}
          />
          <.input_radio
            name="level_of_severity"
            id="medium"
            value="medium"
            label={gettext("Medium")}
            selection={Keyword.get(@search_params, :level_of_severity)}
          />
          <.input_radio
            name="level_of_severity"
            id="high"
            value="high"
            label={gettext("High")}
            selection={Keyword.get(@search_params, :level_of_severity)}
          />
          <.input_radio
            name="level_of_severity"
            id="all"
            value="all"
            label={gettext("All")}
            selection={Keyword.get(@search_params, :level_of_severity)}
          />
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Is Casual?")}</p>
        <div>
          <.input_radio
            name="casual"
            id="casual_true"
            value="true"
            label={gettext("Yes")}
            selection={Keyword.get(@search_params, :casual)}
          />
          <.input_radio
            name="casual"
            id="casual_false"
            value="false"
            label={gettext("No")}
            selection={Keyword.get(@search_params, :casual)}
          />
          <.input_radio
            name="casual"
            id="casual_all"
            value="all"
            label={gettext("All")}
            selection={Keyword.get(@search_params, :casual)}
          />
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Is Appropriated?")}</p>
        <div>
          <.input_radio
            name="appropriated"
            id="appropriated_true"
            value="true"
            label={gettext("Yes")}
            selection={Keyword.get(@search_params, :appropriated)}
          />
          <.input_radio
            name="appropriated"
            id="appropriated_false"
            value="false"
            label={gettext("No")}
            selection={Keyword.get(@search_params, :appropriated)}
          />
          <.input_radio
            name="appropriated"
            id="appropriated_all"
            value="all"
            label={gettext("All")}
            selection={Keyword.get(@search_params, :appropriated)}
          />
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Source")}</p>
        <div>
          <.input_radio
            name="source"
            id="plugin"
            value="plugin"
            label={gettext("Plugin")}
            selection={Keyword.get(@search_params, :source)}
          />
          <.input_radio
            name="source"
            id="experts_2022"
            value="experts_2022"
            label={gettext("Experts 2022")}
            selection={Keyword.get(@search_params, :source)}
          />
          <.input_radio
            name="source"
            id="crowdsourcing_exercise"
            value="crowdsourcing_exercise"
            label={gettext("Crowdsourcing Exercise")}
            selection={Keyword.get(@search_params, :source)}
          />
          <.input_radio
            name="source"
            id="source_all"
            value="all"
            label={gettext("All")}
            selection={Keyword.get(@search_params, :source)}
          />
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Language")}</p>
        <form phx-change="change-language">
          <label for="language-filter" class="sr-only">{gettext("Language")}</label>
          <select
            name="language"
            id="language-filter"
            class="border border-gray-300 rounded p-2 text-sm w-auto"
          >
            <option value="all" selected={Keyword.get(@search_params, :language) == "all"}>
              {gettext("All")}
            </option>
            <%= for {name, code} <- @language_options do %>
              <option value={code} selected={Keyword.get(@search_params, :language) == code}>
                {name}
              </option>
            <% end %>
          </select>
        </form>
      </div>

      <div>
        <p class="py-2">{gettext("Categories")}</p>
        <div>
          <.checkbox
            id="gendered"
            group="categories"
            label={gettext("Gendered")}
            selection={
              if "gendered" in Keyword.get(@search_params, :categories, []),
                do: ["gendered"],
                else: [""]
            }
          />
          <.checkbox
            id="sexualized"
            group="categories"
            label={gettext("Sexualized")}
            selection={
              if "sexualized" in Keyword.get(@search_params, :categories, []),
                do: ["sexualized"],
                else: [""]
            }
          />
          <.checkbox
            id="religion"
            group="categories"
            label={gettext("Religion")}
            selection={
              if "religion" in Keyword.get(@search_params, :categories, []),
                do: ["religion"],
                else: [""]
            }
          />
          <.checkbox
            id="ethnicity"
            group="categories"
            label={gettext("Ethnicity")}
            selection={
              if "ethnicity" in Keyword.get(@search_params, :categories, []),
                do: ["ethnicity"],
                else: [""]
            }
          />
          <.checkbox
            id="political_affiliation"
            group="categories"
            label={gettext("Political Affiliation")}
            selection={
              if "political_affiliation" in Keyword.get(@search_params, :categories, []),
                do: ["political_affiliation"],
                else: [""]
            }
          />
          <.checkbox
            id="caste"
            group="categories"
            label={gettext("Caste")}
            selection={
              if "caste" in Keyword.get(@search_params, :categories, []),
                do: ["caste"],
                else: [""]
            }
          />
          <.checkbox
            id="class"
            group="categories"
            label={gettext("Class")}
            selection={
              if "class" in Keyword.get(@search_params, :categories, []),
                do: ["class"],
                else: [""]
            }
          />
          <.checkbox
            id="body_shaming"
            group="categories"
            label={gettext("Body Shaming")}
            selection={
              if "body_shaming" in Keyword.get(@search_params, :categories, []),
                do: ["body_shaming"],
                else: [""]
            }
          />
          <.checkbox
            id="ableist"
            group="categories"
            label={gettext("Ableist")}
            selection={
              if "ableist" in Keyword.get(@search_params, :categories, []),
                do: ["ableist"],
                else: [""]
            }
          />
          <.checkbox
            id="sexual_identity"
            group="categories"
            label={gettext("Sexual Identity")}
            selection={
              if "sexual_identity" in Keyword.get(@search_params, :categories, []),
                do: ["sexual_identity"],
                else: [""]
            }
          />
          <.checkbox
            id="other"
            group="categories"
            label={gettext("Other")}
            selection={
              if "other" in Keyword.get(@search_params, :categories, []),
                do: ["other"],
                else: [""]
            }
          />
        </div>
      </div>

      <div>
        <p class="py-2">{gettext("Sort")}</p>
        <div>
          <.input_radio
            name="sort-by"
            id="newest"
            value="newest"
            label={gettext("Newest first")}
            selection={Keyword.get(@search_params, :sort)}
          />
          <.input_radio
            name="sort-by"
            id="oldest"
            value="oldest"
            label={gettext("Oldest first")}
            selection={Keyword.get(@search_params, :sort)}
          />
        </div>
      </div>
    <% end %>
  </div>
  <!-- Floating Filter Button (Mobile/Tablet only) -->
  <button
    id="mobile-filter-button"
    phx-click={
      JS.add_class("hidden", to: "#mobile-filter-button")
      |> JS.show(to: "#mobile-filters-drawer")
    }
    class="lg:hidden fixed bottom-6 right-6 p-4 rounded-full shadow-lg z-50"
    style="background-color: rgb(231, 109, 103); color: rgb(81, 78, 128);"
  >
    <!-- filter icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L15 13.414V19a1 1 0 01-.447.832l-4 2.5A1 1 0 019 21v-7.586L3.293 6.707A1 1 0 013 6V4z"
      />
    </svg>
  </button>
  <!-- Mobile Filter Drawer -->
  <div id="mobile-filters-drawer" class="lg:hidden hidden fixed inset-0 z-40">
    <!-- Overlay -->
    <div
      class="absolute inset-0 bg-black/50"
      phx-click={
        JS.hide(to: "#mobile-filters-drawer")
        |> JS.exec(
          "setTimeout(()=>{ document.getElementById('mobile-filter-button').classList.remove('hidden') }, 200)"
        )
      }
      phx-transition-enter="transition-opacity ease-out duration-300"
      phx-transition-enter-from="opacity-0"
      phx-transition-enter-to="opacity-100"
      phx-transition-leave="transition-opacity ease-in duration-200"
      phx-transition-leave-from="opacity-100"
      phx-transition-leave-to="opacity-0"
    >
    </div>
    <!-- Sliding Drawer -->
    <div
      class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl p-6 max-h-[80vh] overflow-y-auto shadow-lg"
      phx-transition-enter="transform transition ease-out duration-300"
      phx-transition-enter-from="translate-y-full"
      phx-transition-enter-to="translate-y-0"
      phx-transition-leave="transform transition ease-in duration-200"
      phx-transition-leave-from="translate-y-0"
      phx-transition-leave-to="translate-y-full"
    >
      <!-- Header -->
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold">{gettext("Filter By")}</h2>
        <button
          phx-click={
            JS.hide(to: "#mobile-filters-drawer")
            |> JS.remove_class("hidden", to: "#mobile-filter-button")
          }
          class="text-gray-500 hover:text-gray-800"
        >
          ✕
        </button>
      </div>
      <!-- Form -->
      <.form
        for={%{}}
        phx-submit={
          JS.push("apply-mobile-filters")
          |> JS.hide(to: "#mobile-filters-drawer")
          |> JS.remove_class("hidden", to: "#mobile-filter-button")
        }
      >
        <!-- Date Range -->
        <div class="mb-4">
          <p class="font-medium mb-2">{gettext("Date")}</p>
          <div class="flex flex-col gap-2">
            <input
              type="date"
              name="filters[from]"
              class="border rounded p-2 text-sm"
              placeholder={gettext("From")}
            />
            <input
              type="date"
              name="filters[to]"
              class="border rounded p-2 text-sm"
              placeholder={gettext("To")}
            />
          </div>
        </div>
        <!-- Level of Severity -->
        <div class="mb-4">
          <p class="font-medium mb-2">{gettext("Level of Severity")}</p>
          <select name="filters[level_of_severity]" class="border rounded p-2 text-sm w-full">
            <option value="low">{gettext("Low")}</option>
            <option value="medium">{gettext("Medium")}</option>
            <option value="high">{gettext("High")}</option>
            <option value="all" selected>{gettext("All")}</option>
          </select>
        </div>
        <!-- Source -->
        <div class="mb-4">
          <p class="font-medium mb-2">{gettext("Source")}</p>
          <select name="filters[source]" class="border rounded p-2 text-sm w-full">
            <option value="plugin">{gettext("Plugin")}</option>
            <option value="experts_2022">{gettext("Experts 2022")}</option>
            <option value="crowdsourcing_exercise">{gettext("Crowdsourcing Exercise")}</option>
            <option value="all" selected>{gettext("All")}</option>
          </select>
        </div>
        <!-- Categories -->
        <div class="mb-4">
          <p class="font-medium mb-2">{gettext("Categories")}</p>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <label>
              <input type="checkbox" name="filters[categories][]" value="gendered" /> {gettext(
                "Gendered"
              )}
            </label>
            <label>
              <input type="checkbox" name="filters[categories][]" value="sexualized" /> {gettext(
                "Sexualized"
              )}
            </label>
            <label>
              <input type="checkbox" name="filters[categories][]" value="religion" /> {gettext(
                "Religion"
              )}
            </label>
            <label>
              <input type="checkbox" name="filters[categories][]" value="ethnicity" /> {gettext(
                "Ethnicity"
              )}
            </label>
            <label>
              <input type="checkbox" name="filters[categories][]" value="class" /> {gettext(
                "Class"
              )}
            </label>
            <label>
              <input type="checkbox" name="filters[categories][]" value="caste" /> {gettext(
                "Caste"
              )}
            </label>
          </div>
        </div>
        <!-- Sort -->
        <div class="mb-6">
          <p class="font-medium mb-2">{gettext("Sort")}</p>
          <select name="filters[sort]" class="border rounded p-2 text-sm w-full">
            <option value="newest" selected>{gettext("Newest first")}</option>
            <option value="oldest">{gettext("Oldest first")}</option>
          </select>
        </div>
        <!-- Buttons -->
        <div class="flex justify-between">
          <.link
            href={
              ~p"/crowdsource-contributions?page_num=1&sort=newest&level_of_severity=all&source=all"
            }
            class="px-4 py-2 rounded bg-gray-200 text-sm"
          >
            {gettext("Clear Filters")}
          </.link>

          <button
            type="submit"
            class="px-4 py-2 rounded text-sm text-white font-medium"
            style="background-color: rgb(231, 109, 103); color: rgb(81, 78, 128);"
          >
            {gettext("Apply Filters")}
          </button>
        </div>
      </.form>
    </div>
  </div>

  <div class="w-full sm:w-4/5 gap-4">
    <div class="flex items-center justify-between w-full mb-4">
      <!-- Left Tabs -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Active -->
        <button
          type="button"
          class="flex h-9 items-center gap-2 rounded-[10px] border-2 border-[#FF5A52] bg-[#FFD9D6] px-4"
        >
          <span class="text-[13px] font-semibold text-[#111827]">
            All Slurs
          </span>

          <span class="flex h-5 min-w-[24px] items-center justify-center rounded-full border border-[#CFCFCF] bg-white px-2 text-[11px] font-semibold text-[#444]">
            5
          </span>
        </button>

        <!-- Inactive -->
        <button
          type="button"
          class="flex h-9 items-center gap-2 rounded-[10px] border border-[#D3C9BC] bg-[#EFE6DA] px-4"
        >
          <span class="text-[13px] font-medium text-[#9A9188]">
            Approved Slurs
          </span>

          <span class="flex h-5 min-w-[24px] items-center justify-center rounded-full border border-[#D7D1C8] bg-[#F6F2EC] px-2 text-[11px] font-medium text-[#A49B92]">
            5
          </span>
        </button>
      </div>

      <!-- Right Side -->
      <div class="ml-auto flex items-center gap-6">
        <!-- Warning -->
        <div class="flex items-center gap-2 whitespace-nowrap shrink-0">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="#E58A00"
            class="h-4 w-4"
          >
            <path d="M10 2L1.5 17h17L10 2Zm0 5.2c.4 0 .7.3.7.7v3.3a.7.7 0 11-1.4 0V7.9c0-.4.3-.7.7-.7Zm0 7a.9.9 0 110-1.8.9.9 0 010 1.8Z" />
          </svg>

          <span class="text-[12px] font-semibold text-[#D97706]">
            Filters are disabled in Grouped View.
          </span>
        </div>

        <!-- Group -->
        <button
          type="button"
          class="flex h-9 shrink-0 items-center gap-2 rounded-full border border-[#D8D8D8] bg-white px-4 shadow-sm"
        >
          <.icon name="hero-squares-2x2" class="h-4 w-4 text-[#444]" />

          <span class="whitespace-nowrap text-[13px] text-[#222]">
            <span class="font-semibold">Group</span> : Similar Slurs
          </span>

          <.icon name="hero-chevron-down-mini" class="h-4 w-4 text-[#555]" />
        </button>

        <!-- Sort -->
        <button
          type="button"
          class="flex h-9 shrink-0 items-center gap-2 rounded-full border border-[#D8D8D8] bg-white px-4 shadow-sm"
        >
          <.icon name="hero-bars-3-bottom-left" class="h-4 w-4 text-[#444]" />

          <span class="whitespace-nowrap text-[13px] text-[#222]">
            <span class="font-semibold">Sort</span> : Newest First
          </span>

          <.icon name="hero-chevron-down-mini" class="h-4 w-4 text-[#555]" />
        </button>
      </div>
    </div>
    <div
      :if={!@advanced_search}
      class="flex items-center justify-between border rounded-lg px-4 py-3 bg-white"
    >
      <div class="flex items-center gap-1">
        <!-- Previous -->
        <%= if @current_page > 1 do %>
          <.link
            navigate={
          "/crowdsource-contributions?" <>
          CrowdsourceContributionsSearchParams.search_param_string(
            Keyword.put(@search_params, :page_num, @current_page - 1)
          )
        }
            class="w-8 h-8 flex items-center justify-center border rounded hover:bg-gray-100"
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" />
          </.link>
        <% else %>
          <button
            disabled
            class="w-8 h-8 flex items-center justify-center border rounded text-gray-300"
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" />
          </button>
        <% end %>

        <!-- Next -->
        <%= if @current_page < @total_pages do %>
          <.link
            navigate={
          "/crowdsource-contributions?" <>
          CrowdsourceContributionsSearchParams.search_param_string(
            Keyword.put(@search_params, :page_num, @current_page + 1)
          )
        }
            class="w-8 h-8 flex items-center justify-center border rounded hover:bg-gray-100"
          >
            <.icon name="hero-chevron-right" class="w-4 h-4" />
          </.link>
        <% else %>
          <button
            disabled
            class="w-8 h-8 flex items-center justify-center border rounded text-gray-300"
          >
            <.icon name="hero-chevron-right" class="w-4 h-4" />
          </button>
        <% end %>

        <!-- Pages -->

        <%= for page <- @page_numbers do %>
          <.link
            navigate={
          "/crowdsource-contributions?" <>
          CrowdsourceContributionsSearchParams.search_param_string(
            Keyword.put(@search_params, :page_num, page)
          )
        }
            class={
              if page == @current_page do
                "w-8 h-8 rounded-full bg-red-500 text-white flex items-center justify-center font-semibold"
              else
                "w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center"
              end
            }
          >
            {page}
          </.link>
        <% end %>

        <%= if List.last(@page_numbers) < @total_pages do %>
          <span class="px-2 text-gray-500">
            ...
          </span>

          <.link
            navigate={
          "/crowdsource-contributions?" <>
          CrowdsourceContributionsSearchParams.search_param_string(
            Keyword.put(@search_params, :page_num, @total_pages)
          )
        }
            class={
              if @current_page == @total_pages do
                "w-8 h-8 rounded-full bg-red-500 text-white flex items-center justify-center"
              else
                "w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center"
              end
            }
          >
            {@total_pages}
          </.link>
        <% end %>
      </div>

      <div class="flex items-center gap-3 text-sm text-gray-700 whitespace-nowrap">
        <span class="font-medium">Goto Page</span>

        <form phx-change="goto-page">
          <div class="relative inline-block">
            <select
              name="page_num"
              class="appearance-none border border-gray-300 rounded-md bg-white py-1 pl-3 pr-10 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 cursor-pointer"
            >
              <%= for page <- 1..@total_pages do %>
                <option value={page} selected={page == @current_page}>
                  {page}
                </option>
              <% end %>
            </select>

            <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="h-2" />

    <%= if @vector_search_loading do %>
      <div class="flex flex-col items-center justify-center py-12">
        <svg
          class="animate-spin h-8 w-8 text-zinc-600 mb-2"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M12 4a8 8 0 0 1 8 8h2a10 10 0 1 0-10 10v-2a8 8 0 0 1 0-16z"
          />
        </svg>
        <span class="text-lg text-zinc-700 font-medium">{gettext("Searching...")}</span>
      </div>
    <% else %>
      <.table id="crowdsource-slur-metadata-table" rows={@slurs_metadata_list}>
        <:col :let={slur} label={gettext("Slur's Label")}>{slur.label}</:col>
        <:col :let={slur} label={gettext("Level of Severity")}>
          {slur.level_of_severity || "-"}
        </:col>
        <:col :let={slur} label={gettext("Language")}>{slur.language || "-"}</:col>
        <:col :let={slur} label={gettext("Is Casual?")}>
          {if is_nil(slur.casual),
            do: "-",
            else: (slur.casual == true && gettext("Yes")) || gettext("No")}
        </:col>

        <:col :let={slur} label={gettext("Is Appropriated?")}>
          {if is_nil(slur.appropriated),
            do: "-",
            else: (slur.appropriated == true && gettext("Yes")) || gettext("No")}
        </:col>
        <:col :let={slur} label={gettext("Appropriation Context")}>
          {if is_nil(slur.appropriation_context),
            do: "-",
            else: (slur.appropriation_context == true && gettext("Yes")) || gettext("No")}
        </:col>

        <:col :let={slur} label={gettext("Meaning")}>{slur.meaning || "-"}</:col>
        <:col :let={slur} label={gettext("Categories")}>
          <div class="flex flex-wrap gap-2">
            <%= if Enum.empty?(slur.categories || []) do %>
              -
            <% else %>
              <%= for category <- slur.categories do %>
                <.slur_category_badge category={to_string(category)} />
              <% end %>
            <% end %>
          </div>
        </:col>
        <:action :let={slur}>
          <%= if @user_role == :admin do %>
            <.button phx-click={
              JS.push("open-add-slur-modal", value: %{slur: slur}) |> show_modal("add-slur-modal")
            }>
              {gettext("Add")}
            </.button>
          <% end %>
        </:action>
      </.table>
    <% end %>
  </div>
</div>
